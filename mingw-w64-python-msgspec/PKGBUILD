# Maintainer: Jonatan R. Fischer <jonafischer at gmail dot com>
# shellcheck shell=bash disable=SC2034,SC2154

_realname=msgspec
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.22.0
pkgrel=1
pkgdesc="A fast and friendly JSON/MessagePack library, with optional schema validation"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/jcrist/msgspec"
license=('spdx:BSD-3-Clause')
msys2_references=(
  'purl: pkg:pypi/msgspec'
)

depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools-scm"
  "${MINGW_PACKAGE_PREFIX}-python-wheel"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-attrs"
  "${MINGW_PACKAGE_PREFIX}-python-msgpack"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pyaml"
  "${MINGW_PACKAGE_PREFIX}-python-tomli-w"
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/jcrist/msgspec/archive/refs/tags/${pkgver}.tar.gz"
  # Upstream setup.py passes MSVC-only C11 atomics flags on win32, which
  # break MinGW (GCC) builds; gate them on the compiler not being gcc.
  '0001-mingw_skip_msvc_c11_flags.patch'
  # MinGW extensions get no __declspec(dllimport) for PyAPI_FUNC (CPython
  # exports.h), so the encoder's tp_getattro == PyObject_GenericGetAttr
  # check compares against an import thunk and always fails; ClassVar
  # dataclass fields then leak into json/msgpack output. Resolve the real
  # address through the import address table.
  '0001-mingw_generic_getattr_iat.patch'
)
sha256sums=(
  'c4ff244478885f25c4375f99efa8f8c27a854e0f2644df3fd6148df62a780cb9'
  'aa97b50e044d91f84b7692ebfc4605e27c6a1dc8def6ab4eae32fefb035f54c2'
  '61357a64d85f42b537d87e88bbc7def76121031601395ebf2743519f14d0f7f1'
)

prepare() {
  rm -rf python-build-${MSYSTEM}
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}"
  cd "${srcdir}/python-build-${MSYSTEM}"
  patch -Np1 -i "${srcdir}/0001-mingw_skip_msvc_c11_flags.patch"
  patch -Np1 -i "${srcdir}/0001-mingw_generic_getattr_iat.patch"
}

build() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  # The build tree is not a git checkout and its name does not match the
  # parentdir_prefix ("msgspec-"), so pin the version explicitly.
  SETUPTOOLS_SCM_PRETEND_VERSION="${pkgver}" \
    ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  rm -rf test-env
  ${MINGW_PREFIX}/bin/python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest tests/unit
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}

# vim:set ts=2 sw=2 et:
