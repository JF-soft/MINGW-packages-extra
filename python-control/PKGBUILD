# Maintainer: Jonatan R. Fischer <jonafischer at gmail dot com>

_realname=control
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.10.2
pkgrel=6
pkgdesc="Python Control Systems Library."
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
license=('spdx:BSD-3-Clause')
url="https://github.com/python-control/python-control"
msys2_references=(
  'purl: pkg:pypi/control'
)
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-numpy"
  "${MINGW_PACKAGE_PREFIX}-python-scipy"
  "${MINGW_PACKAGE_PREFIX}-python-matplotlib"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-slycot: slycot"
  "${MINGW_PACKAGE_PREFIX}-python-cvxopt: cvxopt"
  "${MINGW_PACKAGE_PREFIX}-python-pandas: pandas"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools-scm"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-wheel"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pytest-timeout"
  "${MINGW_PACKAGE_PREFIX}-python-numpydoc"
  "${MINGW_PACKAGE_PREFIX}-python-slycot"
  "${MINGW_PACKAGE_PREFIX}-python-cvxopt"
  "${MINGW_PACKAGE_PREFIX}-python-pandas"
)
source=(
  "https://files.pythonhosted.org/packages/source/${_realname:0:1}/$_realname/$_realname-$pkgver.tar.gz"
  # Backport of upstream commit ae4915c4ece5f417fa514dadeb0d30ab412a28aa:
  # NumPy 2.5 deprecates in-place assignment to ndarray.shape; the
  # DeprecationWarnings leak into pytest.warns(record=True) and break
  # control/tests/nyquist_test.py::test_nyquist_basic (assert 11 == 2).
  '0001-numpy25_shape_deprecation.patch'
)
sha256sums=('d0cf63f6cfb68a4c8e827c26c3744d129e9777fedc9a5d86ca4740548f23a98b'
            'ed4aaecc0cf174739992c0bd4780754e630f24b3b2cd28c4d1bc7761e3253d1b')

prepare() {
  rm -rf python-build-${MSYSTEM}
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}"
  cd "${srcdir}/python-build-${MSYSTEM}"

  # Fix numpy 2.5 "Setting the shape on a NumPy array has been deprecated"
  # DeprecationWarnings, which leak into pytest.warns(record=True) and break
  # nyquist_test.py::test_nyquist_basic. Upstream commit ae4915c.
  # JF: git apply does NOT work here: when srcdir is a subdirectory of an
  # outer git repo (this repo), git silently skips the patch and exits 0
  # ("Skipped patch '...'"), so use plain patch instead.
  patch -Np1 -i "${srcdir}/0001-numpy25_shape_deprecation.patch"

  # JF: it seems that this is not working (I commented this on the AUR website)!
  #sed -i "s/('shooting', 3, None, 'xfail')/('shooting', 3, None, 'endpoint')/g" control/tests/optimal_test.py
  #sed -i "s/('shooting', 3, 'zero', 'xfail')/('shooting', 3, 'zero', 'endpoint')/g" control/tests/optimal_test.py
  #sed -i "s/# ('shooting', 3, 'u0', None)/('shooting', 3, 'u0', None)/g" control/tests/optimal_test.py
}

build() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --no-isolation --skip-dependency-check
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    # JF: this test does not work on mingw!, it depends on how Matplotlib handles plots, not required for this system.
    --deselect control/tests/ctrlplot_test.py::test_pole_zero_subplots
  )
  cd "${srcdir}/python-build-${MSYSTEM}"

  ${MINGW_PREFIX}/bin/python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl

  # JF: Avoid GUI backends (Tk) in CI/build environments with partial Tcl/Tk installs
  MPLBACKEND=Agg test-env/bin/python -P -m pytest "${pytest_options[@]}" ${_realname}/tests
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
