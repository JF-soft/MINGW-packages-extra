# Maintainer: envolution
# Contributor: rumpelsepp <stefan at rumpelsepp dot org>
# Contributor: Carl Smedstad <carsme@archlinux.org>
# shellcheck shell=bash disable=SC2034,SC2154

_realname=msgspec
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.19.0
pkgrel=1
pkgdesc="A fast and friendly JSON/MessagePack library, with optional schema validation"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/jcrist/msgspec"
license=('spdx:BSD-3-Clause')
msys2_references=(
  'purl: pkg:pypi/msgspec'
)

depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-attrs"
  "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
)
makedepends=(
  "git"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  "${MINGW_PACKAGE_PREFIX}-python-wheel"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-msgpack"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-tomli-w: for TOML support"
  "${MINGW_PACKAGE_PREFIX}-python-tomli: for TOML support"
  "${MINGW_PACKAGE_PREFIX}-python-yaml: for YAML support"
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/jcrist/msgspec/archive/refs/tags/${pkgver}.tar.gz"
  "0001-avoid_dataclass_classvar_test_on_windows.patch"
)
sha256sums=(
  '33961077a37830c54fa3108bd226a9d7a09b91ff82ef7b976a371039b54b6bc7'
  'f16ec0dd19aa12208af56261298ec66916b36bf64b81bb1ddd181d54bd87fcfb'
)

prepare() {
  rm -rf python-build-${MSYSTEM}
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}"
  cd "${srcdir}/python-build-${MSYSTEM}"
  patch -p1 < "${srcdir}/0001-avoid_dataclass_classvar_test_on_windows.patch"
}

build() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  # JF: there are two test that are failing in windows. Check out why!
  rm -rf test-env
  ${MINGW_PREFIX}/bin/python -m venv --system-site-packages test-env
  local site_packages=$(${MINGW_PREFIX}/bin/python -c "import site; print(site.getsitepackages()[0].replace('/usr/', ''))")
  export PYTHONPATH="$PWD/test-env/$site_packages"
  test-env/bin/python -m installer "${srcdir}/python-build-${MSYSTEM}/dist/"*.whl
  test-env/bin/python -m pytest "${srcdir}/$_realname-$pkgver/tests/"
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}

# vim:set ts=2 sw=2 et:
