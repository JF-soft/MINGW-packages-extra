# Maintainer: Jonatan R. Fischer <jonafischer at gmail dot com>

_realname=forgejo-cli
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.7.0
pkgrel=1
pkgdesc="CLI tool for interacting with Forgejo instances, written in Rust"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://codeberg.org/forgejo-contrib/forgejo-cli"
msys2_repository_url="https://codeberg.org/forgejo-contrib/forgejo-cli"
msys2_changelog_url="https://codeberg.org/forgejo-contrib/forgejo-cli/releases"
license=('spdx:Apache-2.0 OR MIT')
# NOTE: upstream ships only prebuilt Linux/MSVC binaries on the release page;
# this package builds natively with the MSYS2 rust toolchain. Unlike the Arch
# package, upstream's own release builds use the default Cargo features, so
# the optional "update-check" feature is not enabled here.
#
# libgit2-sys links the system libgit2 instead of vendoring it (LIBGIT2_NO_VENDOR
# below makes that explicit), and libssh2-sys is linked against the system
# libssh2 for the same reason (MSYS2 policy: prefer system libraries). Verified
# with objdump -p: apart from Windows system DLLs (UCRT, advapi32, crypt32,
# combase, shell32, ws2_32, bcryptprimitives, kernel32, ntdll) the only mingw
# imports are libgit2-1.9.dll and libssh2-1.dll.
depends=(
  "${MINGW_PACKAGE_PREFIX}-libgit2"
  "${MINGW_PACKAGE_PREFIX}-libssh2"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
)
# NOTE: the upstream tag is "v0.7.0" (with "v" prefix). Forgejo names the tag
# archive "forgejo-cli.tar.gz" (no version), hence the filename::URL form, and
# it extracts to a directory without a version suffix. The installed binary is
# "fj" (see the [[bin]] section of Cargo.toml), not forgejo-cli.exe.
source=("${_realname}-${pkgver}.tar.gz::https://codeberg.org/forgejo-contrib/forgejo-cli/archive/v${pkgver}.tar.gz")
sha256sums=('748ce60eb18e72af83ef3956910933b1e091abf673f12ff9777aea214f6eae40')

_srcname="forgejo-cli"
# Cargo.toml does not declare rust-version; edition 2024 requires Rust >= 1.85.
_required_rust='1.85'

# See the note above on system libraries.
export LIBGIT2_NO_VENDOR=1
export LIBSSH2_SYS_USE_PKG_CONFIG=1

prepare() {
  cd "${srcdir}/${_srcname}"

  local current
  current="$(rustc --version | awk '{print $2}')"
  if [ "$(vercmp "$current" "${_required_rust}")" -lt 0 ]; then
    printf 'rustc %s is older than the required %s (edition 2024); the build may fail\n' \
      "$current" "${_required_rust}"
    return 1
  fi

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${srcdir}/${_srcname}"
  cargo build --release --frozen
}

check() {
  cd "${srcdir}/${_srcname}"
  # Upstream unit tests are offline and fast (localization, ssh URL parsing).
  cargo test --frozen
  # Smoke test: fj has no --version flag (clap is configured without one).
  ./target/release/fj.exe --help
}

package() {
  cd "${srcdir}/${_srcname}"

  install -Dm755 target/release/fj.exe \
    "${pkgdir}${MINGW_PREFIX}/bin/fj.exe"

  # shell completions (fj completion <shell>; bash, fish and zsh, as Arch does)
  install -Dm644 <(./target/release/fj.exe completion bash) \
    "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/fj"
  install -Dm644 <(./target/release/fj.exe completion fish) \
    "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/fj.fish"
  install -Dm644 <(./target/release/fj.exe completion zsh) \
    "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_fj"

  install -Dm644 LICENSE-APACHE \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-APACHE"
  install -Dm644 LICENSE-MIT \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-MIT"
}
